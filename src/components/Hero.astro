---
export interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image: string;
  isPageHero?: boolean;
}

const { eyebrow, title, lead, image, isPageHero = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{
  isPageHero ? (
    <section class="page-hero wrap">
      <div class="ph-inner" style={`background-image:url(${base}assets/img/${image})`}>
        <div class="ph-text">
          <p class="eyebrow light">{eyebrow}</p>
          <h1 set:html={title} />
          <p set:html={lead} />
        </div>
      </div>
    </section>
  ) : null
}
