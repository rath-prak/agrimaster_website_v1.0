---
import type { Product } from '../data/products';

export interface Props {
  product: Product;
}

const { product } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class="card pc">
  <a aria-label={`${product.name} feed`} href={`${base}products#${product.id}`}>
    <div class="pc-img">
      <img src={`${base}assets/img/${product.image}`} alt={`${product.name} feed`} loading="lazy" />
    </div>
  </a>
</article>
