---
import type { Product } from '../data/products';

export interface Props {
  product: Product;
  title?: string | undefined;
  text?: string | undefined;
}

const { product, title, text } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class:list={['card pc', { 'pc-photo': title }]}>
  <a aria-label={title ? undefined : `${product.name} feed`} href={`${base}products#${product.id}`}>
    <div class="pc-img">
      <img src={`${base}assets/img/${product.image}`} alt="" loading="lazy" />
    </div>
    {title && (
      <div class="pc-body">
        <h3>{title}</h3>
        <p>{text}</p>
      </div>
    )}
  </a>
</article>
