---
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="wrap fgrid">
    <div>
      <a href={base}
        ><img
          src={`${base}assets/logo-white.svg`}
          alt="Agri Master – Animal Nutrition"
          width="210"
          height="66"
        /></a
      >
      <p class="fblurb">
        Locally owned animal nutrition since 2004. Complete swine, poultry, ruminant and
        aquaculture feed. Part of Medivet Cambodia.
      </p>
      <ul class="social">
        <li><a href="#" aria-label="Facebook (link to be added)">f</a></li>
        <li><a href="#" aria-label="Telegram (link to be added)">tg</a></li>
        <li><a href="#" aria-label="YouTube (link to be added)">yt</a></li>
      </ul>
    </div>
    <nav aria-label="Footer">
      <h2 class="fh">Company</h2>
      <ul>
        <li><a href={`${base}about`}>About us</a></li>
        <li><a href={`${base}about#quality`}>Quality &amp; capacity</a></li>
        <li><a href={`${base}contact`}>Contact</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="fh">Products</h2>
      <ul>
        <li><a href={`${base}products#swine`}>Swine feed</a></li>
        <li><a href={`${base}products#poultry`}>Poultry feed</a></li>
        <li><a href={`${base}products#ruminant`}>Ruminant feed</a></li>
        <li><a href={`${base}products#aquaculture`}>Aquaculture feed</a></li>
      </ul>
    </div>
    <address>
      <h2 class="fh">Contact</h2>
      <p>Feed mill: Kandal Province, near Phnom Penh, Cambodia</p>
      <p>Phone: <span class="todo">[to be provided]</span></p>
      <p>Email: <span class="todo">[to be provided]</span></p>
      <p><a href="https://agrimaster.com.kh">agrimaster.com.kh</a></p>
    </address>
  </div>
  <div class="wrap fbottom">
    <span>© 2026 Agri Master Cambodia. All rights reserved.</span><span class="credit"
      >Hero photo: "Cambodia's rice fields" by Dmitry A. Mottl, <a
        href="https://commons.wikimedia.org/wiki/File:Cambodia%27s_rice_fields.jpg"
        >Wikimedia Commons</a
      >, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Raw materials photos: Dara (<a href="https://commons.wikimedia.org/wiki/File:Khmer_woman_fields.jpg">CC BY 2.0</a>), Sudzie (<a href="https://commons.wikimedia.org/wiki/File:Cambodian_Village_Water_Spinach_Beds.jpg">CC BY-SA 4.0</a>). Product photos: Dragfyre (<a href="https://commons.wikimedia.org/wiki/File:Piglets_Can_Tho.jpg">CC BY-SA 3.0</a>), Mr.Eid&amp;min (<a href="https://commons.wikimedia.org/wiki/File:Layer_chicken.jpg">CC BY-SA 4.0</a>), Dmitry Makeev (<a href="https://commons.wikimedia.org/wiki/File:Mammalia_-_Zebu.jpg">CC BY-SA 4.0</a>), Evgeniy Metyolkin (<a href="https://commons.wikimedia.org/wiki/File:Nong_Prue,_Bang_Lamung_District,_Chon_Buri_20150,_Thailand_-_panoramio_(6).jpg">CC BY-SA 3.0</a>), via Wikimedia Commons. Map boundaries: <a href="https://www.geoboundaries.org/">geoBoundaries</a> (KHM ADM1), © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, <a href="https://opendatacommons.org/licenses/odbl/1-0/">ODbL 1.0</a></span
