---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import RawMaterials from '../components/RawMaterials.astro';
import AvailabilityMap from '../components/AvailabilityMap.astro';
import { getProducts, getQualityStats } from '../lib/products';

const products = await getProducts();
const qualityStats = await getQualityStats();
const storyStats = [qualityStats[1], qualityStats[0]].filter((x): x is { value: string; label: string } => !!x);
const base = import.meta.env.BASE_URL;
const speciesCards: Record<string, { title: string; text: string; color: string; ink?: string }> = {
  swine: { title: 'Swine', text: 'Piglets, growing and finishing pigs, and breeding sows.', color: '#2C3483' },
  poultry: { title: 'Poultry', text: 'Broilers, native chickens, layers and ducks.', color: '#1F6134' },
  ruminant: { title: 'Ruminants', text: 'Beef cattle, dairy cattle, sheep and goats.', color: '#699831', ink: '#1a1a1a' },
  aquaculture: { title: 'Aquaculture', text: 'Floating feeds for freshwater fish.', color: '#FBAF3B', ink: '#1a1a1a' },
};
---

<Layout
  title="Animal Nutrition"
  description="Agri Master Cambodia – locally owned feedmill producing swine, poultry, ruminant and aquaculture feed since 2004."
  pageClass="index"
>
  <Header currentPage="index" />
  <main id="main">
    <section class="hero full">
      <div class="hero-img" style={`--hero-img:url(${base}assets/img/hero-paddy-battambang.webp)`}>
        <div class="hero-content">
          <h1 class="hero-h1-only">Quality Animal Nutrition. Made in Cambodia.</h1>
          <p class="hero-sub">Proudly Cambodian-owned and operated since 2004.</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={`${base}products`}>Explore Animal Feed</a>
            <a class="btn btn-light" href={`${base}about`}>About Agri Master</a>
          </div>
        </div>
      </div>
    </section>
    <section class="section center wrap home-about">
      <h2 class="second-lead">Growing with Cambodia Since 2004</h2>
      <p class="rm-small">Agri Master is one of Cambodia's pioneering animal feed manufacturers. For more than two decades, we have supported local farmers through quality feed, modern manufacturing and practical animal nutrition expertise.</p>
      <p class="rm-small">Our commitment goes beyond producing feed. We aim to contribute to stronger farming communities and the continued development of Cambodia's agricultural sector.</p>
      <a class="btn btn-primary" href={`${base}about`}>Discover Our Story</a>
    </section>
    <section class="wrap section pt0 home-story">
      <div class="story" style={`--story-img:url(${base}assets/img/feedmill-aerial.webp)`}>
        <div class="story-text">
          <h2>Growing with Cambodia Since 2004</h2>
          <p>Agri Master is one of Cambodia's pioneering animal feed manufacturers. For more than two decades, we have supported local farmers through quality feed, modern manufacturing and practical animal nutrition expertise.</p>
          <a class="btn btn-primary" href={`${base}about`}>Discover Our Story</a>
        </div>
        <dl class="story-stats">
          {storyStats.map((st) => <div><dt>{st.value}</dt><dd>{st.label}</dd></div>)}
        </dl>
      </div>
    </section>
    <section class="wrap section">
      <div class="home-intro">
        <div>
        <span class="section-heading">ANIMAL NUTRITION</span>
        <h3 class="second-lead">Quality Animal Feed for Every <br /><span>Stage of Production</span></h3>
        <p class="rm-small">We produce a comprehensive range of high-quality animal feeds for swine, poultry, ruminants and aquaculture. Our feeds are carefully formulated to meet the nutritional needs of different animal species at every stage of production, supporting healthy growth, development and productivity.</p>
        </div>
        <img class="home-intro-img" src={`${base}assets/img/mash-pellet.webp`} alt="Agri Master mash and pellet feed" width="1600" height="900" loading="lazy" />
      </div>
      <div class="grid4 species">
        {
          products.map((product) => {
            const c = speciesCards[product.id];
            return <ProductCard product={product} title={c?.title} text={c?.text} color={c?.color} ink={c?.ink} />;
          })
        }
      </div>
      <div class="species-cta"><a class="btn btn-primary" href={`${base}products`}>View Animal Feed</a></div>
    </section>
    <RawMaterials />
    <section class="wrap section">
      <div class="split home-quality">
        <div>
          <span class="section-heading">Our Commitment to Quality</span>
          <h3 class="second-lead">Quality Begins with Better Ingredients</h3>
          <p class="rm-small">We carefully select high-quality raw materials from Cambodia and trusted international suppliers to produce nutritionally balanced and reliable animal feed.</p>
          <p class="rm-small">From ingredient inspection and laboratory testing to production monitoring and finished-feed checks, quality is integrated throughout our manufacturing process.</p>
          <a class="btn btn-primary" href={`${base}about#quality`}>Learn About Our Quality Standards</a>
        </div>
        <img class="rimg" src={`${base}assets/img/production-line.jpg`} alt="Agri Master feed production line" loading="lazy" />
      </div>
    </section>
    <section class="section center wrap pt0 home-about">
      <h2 class="second-lead">Supporting Cambodia's Agricultural Future</h2>
      <p class="rm-small">As a Cambodian-owned manufacturer, we are committed to strengthening the country's agricultural sector through local sourcing, technical knowledge and long-term partnerships.</p>
      <p class="rm-small">We believe that supporting farmers today helps build a stronger food and agricultural future for Cambodia.</p>
      <a class="btn btn-primary" href={`${base}about`}>Learn About Agri Master</a>
    </section>
    <AvailabilityMap />
  </main>
  <Footer />
</Layout>
