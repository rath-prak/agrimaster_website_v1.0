---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import RawMaterials from '../components/RawMaterials.astro';
import AvailabilityMap from '../components/AvailabilityMap.astro';
import { getProducts } from '../lib/products';

const products = await getProducts();
const base = import.meta.env.BASE_URL;
const speciesCards: Record<string, { title: string; text: string; color: string; ink?: string }> = {
  swine: { title: 'Swine', text: 'Feed for piglets, growing and finishing pigs, and breeding sows.', color: '#2C3483' },
  poultry: { title: 'Poultry', text: 'Feed for broilers, native chickens, laying hens and ducks.', color: '#1F6134' },
  ruminant: { title: 'Ruminants', text: 'Feed for beef cattle, dairy cattle, sheep and goats.', color: '#699831', ink: '#1a1a1a' },
  aquaculture: { title: 'Aquaculture', text: 'Floating feeds for freshwater fish, with selected products for frogs.', color: '#FBAF3B', ink: '#1a1a1a' },
};
const why = [
  ['Quality ingredients', 'Carefully selected materials and dependable sourcing.'],
  ['Controlled manufacturing', 'Production monitoring, laboratory analysis and finished-feed checks.'],
  ['Practical expertise', 'Feeding information and technical knowledge relevant to Cambodian producers.'],
];
const qc = ['Raw-material inspection', 'Production monitoring', 'Laboratory analysis', 'Finished-feed checks'];
---

<Layout
  title="Quality Animal Feed Made in Cambodia"
  description="Cambodian-owned since 2004, Agri Master manufactures animal feed for swine, poultry, ruminants and freshwater aquaculture in Kandal Province."
  pageClass="index"
>
  <Header currentPage="index" />
  <main id="main">
    <section class="hero full">
      <div class="hero-img" style={`--hero-img:url(${base}assets/img/hero-swine-feeding.webp)`}>
        <div class="hero-content">
          <h1 class="hero-h1-only">Growing Together with<br /><span class="hero-line2">Cambodian Farmers Since 2004.</span></h1>
          <p class="hero-sub">Committed to quality animal nutrition and the development of <br class="hero-sub-br" />Cambodia's agricultural sector.</p>
          <p class="hero-badge">Product of Cambodia</p>
        </div>
      </div>
    </section>
    <section class="wrap section home-story">
      <div class="story" style={`--story-img:url(${base}assets/img/feedmill-aerial.webp)`}>
        <div class="story-text">
          <h2>Feeding Cambodia's Future.</h2>
          <p>Behind every farm is a livelihood, a family and a contribution to Cambodia's future.</p>
          <p>At Agri Master, we believe quality animal nutrition is more than a product. It's part of building a stronger agricultural sector. Proudly Cambodian-owned since 2004, we're committed to supporting farmers, advancing animal nutrition and growing alongside the communities we serve.</p>
          <a class="btn btn-primary" href={`${base}about#story`}>Our Story</a>
        </div>
      </div>
    </section>
    <section class="wrap section pt0" aria-labelledby="cats-h">
      <div class="fes-head">
        <div class="fes-left">
          <span class="section-heading">Animal Feed</span>
          <h2 id="cats-h" class="fes-h">Feed for<br />Every Stage</h2>
        </div>
        <div class="fes-right">
          <p>Complete feeds and selected concentrates for swine, poultry, ruminants and freshwater aquaculture.</p>
          <div class="fes-btns">
            <a class="btn btn-primary" href={`${base}products`}>View Products</a>
            <a class="btn btn-outline fes-out" href={`${base}contact`}>Contact Us</a>
          </div>
        </div>
      </div>
      <div class="grid4 species">
        {
          products.map((product) => {
            const c = speciesCards[product.id];
            return <ProductCard product={product} title={c?.title} text={c?.text} />;
          })
        }
      </div>
    </section>
    <section class="wrap section pt0" aria-labelledby="why-h">
      <div class="center">
        <span class="section-heading">Why Agri Master</span>
        <h2 id="why-h" class="second-lead">Built on Quality, Knowledge <span>and Cambodian Commitment</span></h2>
      </div>
      <ul class="why">
        {why.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
      <div class="species-cta center"><a class="btn btn-primary" href={`${base}about#quality`}>Learn About Our Quality</a></div>
    </section>
    <section class="section center wrap pt0 home-about">
      <span class="section-heading">Cambodian Agriculture</span>
      <h2 class="second-lead">Supporting Cambodia's Agricultural Future</h2>
      <p class="rm-small">We prioritise suitable locally grown raw materials when available and source quality ingredients internationally when needed. Together with local manufacturing and industry cooperation, this supports our long-term commitment to Cambodian agriculture.</p>
      <a class="btn btn-primary" href={`${base}about`}>About Agri Master</a>
    </section>
    <RawMaterials />
    <section class="wrap section pt0">
      <div class="split home-quality">
        <div>
          <span class="section-heading">Quality Control</span>
          <h2 class="second-lead">Quality at <span>Every Stage</span></h2>
          <p class="rm-small">Our quality-control process covers raw-material inspection, production monitoring, laboratory analysis and finished-feed checks to help maintain the consistency and reliability of our feed.</p>
          <ol class="qc-steps">{qc.map((t, i) => <li><b>{i + 1}</b><span>{t}</span></li>)}</ol>
          <a class="btn btn-primary" href={`${base}about#quality`}>How We Work</a>
        </div>
        <img class="rimg" src={`${base}assets/img/production-line.jpg`} alt="Agri Master feed production line" loading="lazy" />
      </div>
    </section>
    <AvailabilityMap />
  </main>
  <Footer />
</Layout>
