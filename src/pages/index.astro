---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import StatCard from '../components/StatCard.astro';
import Timeline from '../components/Timeline.astro';
import RawMaterials from '../components/RawMaterials.astro';
import AvailabilityMap from '../components/AvailabilityMap.astro';
import { getProducts, getCapacityStats } from '../lib/products';

const products = await getProducts();
const capacityStats = await getCapacityStats();
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Animal Nutrition"
  description="Agri Master Cambodia – locally owned feedmill producing swine, poultry, ruminant and aquaculture feed since 2004."
  pageClass="index"
>
  <Header currentPage="index" />
  <main id="main">
    <section class="hero full">
      <div class="hero-img" style={`--hero-img:url(${base}assets/img/hero-rice-field.jpg)`}>
        <div class="hero-content">
          <p class="eyebrow light">agri master cambodia · animal nutrition</p>
          <h1>feeding cambodia's farms <span class="accent-l">since 2004</span></h1>
          <div class="hero-row">
            <p class="hero-copy">
              cambodia's first locally owned feedmills
              <span class="pill">PRODUCT OF CAMBODIA</span>
            </p>
            <a class="btn btn-light" href={`${base}products`}>explore our feeds →</a>
          </div>
        </div>
      </div>
    </section>
    <section class="section center wrap">
      <p class="eyebrow">About Agri Master</p>
      <h2>
        Cambodian-owned <span class="accent">animal nutrition</span><br />built for local farmers
      </h2>
      <p class="lead">
        Established in 2004 as part of Medivet Cambodia, Agri Master serves all major segments of
        Cambodia's animal feed sector — and was the first Cambodian company to commercially produce
        floating fish feed.
      </p>
      <a class="btn btn-outline" href={`${base}about`}>Our story</a>
    </section>
    <section class="wrap section pt0">
      <div class="rm-intro home-intro">
        <div>
          <span class="section-heading">ANIMAL NUTRITION</span>
          <h3 class="second-lead">Quality Feed for Every <br /><span>Stage of Production</span></h3>
        </div>
        <div>
          <p class="rm-small">We produce a comprehensive range of high-quality animal feeds for swine, poultry, ruminants and aquaculture. Our feeds are carefully formulated to meet the nutritional needs of different animal species at every stage of production, supporting healthy growth, development and productivity.</p>
          <a class="link" href={`${base}products`}>All products →</a>
        </div>
      </div>
      <div class="grid4">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
      <div class="feat">
        <div class="feat-text">
          <span class="section-heading">Swine feed</span>
          <h3>Diamond Feed 800</h3>
          <p class="feat-sub">Pellet feed for pigs creep (7 days – 8kg)</p>
          <ul class="feat-sizes"><li>5kg</li><li>30kg</li></ul>
          <a class="btn btn-outline" href={`${base}products#swine`}>Swine feed →</a>
        </div>
        <div class="feat-img">
          <img
            src={`${base}assets/img/diamond-feed-800.webp`}
            alt="Diamond Feed 800 pig creep pellet feed in 5kg and 30kg bags"
            width="960"
            height="1200"
            loading="lazy"
          />
        </div>
      </div>
    </section>
    <section class="wrap">
      <div class="band" style={`background-image:url(${base}assets/img/feedmill-aerial.webp)`}>
        <div class="band-text">
          <p class="eyebrow light">Production capacity</p>
          <h2>Scalable infrastructure in Kandal Province</h2>
        </div>
        <div class="band-stats">
          {capacityStats.map((stat) => <StatCard {...stat} />)}
        </div>
      </div>
    </section>
    <section class="section center wrap mission">
      <p>
        We prioritise <span class="hl"
          >local raw materials — corn, cassava and rice by-products</span
        > — combined with quality imports, and <span class="hl">test every batch</span> in-house for
        nutritional value, safety and consistency.
      </p>
    </section>
    <section class="wrap section pt0">
      <div class="sec-head">
        <p class="eyebrow">Milestones</p>
        <h2>Two decades of <span class="accent">growth</span></h2>
      </div>
      <Timeline />
    </section>
    <RawMaterials />
    <AvailabilityMap />
  </main>
  <Footer />
</Layout>
