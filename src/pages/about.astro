---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import StatCard from '../components/StatCard.astro';
import { getQualityStats, getCapacityStats } from '../lib/products';

const qualityStats = await getQualityStats();
const capacityStats = await getCapacityStats();
const base = import.meta.env.BASE_URL;
---

<Layout
  title="About"
  description="Our story, milestones, values, quality control and capacity."
  pageClass="about"
>
  <Header currentPage="about" />
  <main id="main">
    <Hero
      eyebrow="About us"
      title="Our story"
      lead="Agri Master was established in 2004 as part of Medivet Cambodia, as one of Cambodia's first locally owned feedmills."
      image="feedmill.jpg"
      isPageHero={true}
    />
    <section class="wrap section">
      <div class="band" style={`background-image:url(${base}assets/img/feedmill-aerial.webp)`}>
        <div class="band-text">
          <p class="eyebrow light">Production capacity</p>
          <h2>Scalable infrastructure in Kandal Province</h2>
        </div>
        <div class="band-stats">
          {capacityStats.map((stat) => <StatCard {...stat} />)}
        </div>
      </div>
    </section>
    <section class="wrap section pt0 split">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2>Proudly <span class="accent">Cambodian</span></h2>
        <p class="lead l">
          We were established to serve the growing domestic feed market. Today Agri Master produces
          a full range of animal feed — swine, poultry, ruminant and aquaculture — and we were the
          first Cambodian company to commercially produce floating fish feed.
        </p>
        <p class="muted">
          Since our founding, Agri Master has steadily grown to serve all major segments of
          Cambodia's animal feed sector.
        </p>
      </div>
      <img
        class="rimg"
        src={`${base}assets/img/feedmill-tower.jpg`}
        alt="Agri Master feed mill tower"
        loading="lazy"
      />
    </section>
    <section class="wrap section pt0">
      <div class="sec-head">
        <p class="eyebrow">Milestones</p>
        <h2>Two decades of <span class="accent">growth</span></h2>
      </div>
      <Timeline />
    </section>
    <section class="wrap section pt0">
      <div class="sec-head">
        <p class="eyebrow">Mission &amp; values</p>
        <h2>What <span class="accent">guides us</span></h2>
        <p class="muted">
          Values summarised from our company profile. <span class="todo"
            >Formal mission statement to be provided.</span
          >
        </p>
      </div>
      <div class="grid4 why">
        <div>
          <span class="dot d1"></span>
          <h3>Serve local farmers</h3>
          <p>
            Brand lines tailored to the needs of farmers in different regional markets across
            Cambodia.
          </p>
        </div>
        <div>
          <span class="dot d2"></span>
          <h3>Support local sourcing</h3>
          <p>
            Prioritising local corn, cassava and rice by-products, in line with our agreement with
            the Ministry of Commerce.
          </p>
        </div>
        <div>
          <span class="dot d3"></span>
          <h3>Quality &amp; safety</h3>
          <p>
            Quality control integrated into every stage to support animal health, growth
            performance, farm productivity and food safety.
          </p>
        </div>
        <div>
          <span class="dot d4"></span>
          <h3>Grow with Cambodia</h3>
          <p>Continuing to expand and modernise to meet growing demand.</p>
        </div>
      </div>
    </section>

    <section id="quality" class="wrap section pt0">
      <div class="sec-head">
        <p class="eyebrow">Quality &amp; capacity</p>
        <h2>Built for <span class="accent">quality and scale</span></h2>
        <p class="muted">
          Quality control is integrated into every stage of our production process to support animal
          health, growth performance, farm productivity and food safety.
        </p>
      </div>
      <div class="bigstats">
        {
          qualityStats.map((stat) => (
            <div>
              <b>{stat.value}</b>
              <span>{stat.label}</span>
            </div>
          ))
        }
      </div>
      <div class="grid4 why mt2">
        <div>
          <span class="dot d1"></span>
          <h3>Raw material inspection</h3>
          <p>Raw materials are inspected and tested before they are accepted and stored.</p>
        </div>
        <div>
          <span class="dot d2"></span>
          <h3>Production monitoring</h3>
          <p>Modern PLC and SCADA technology monitors and controls manufacturing.</p>
        </div>
        <div>
          <span class="dot d3"></span>
          <h3>Laboratory analysis</h3>
          <p>Moisture, crude protein, crude fat, crude fibre and ash analysed before packing.</p>
        </div>
        <div>
          <span class="dot d4"></span>
          <h3>Finished product checks</h3>
          <p>Physical quality and particle size inspected against established standards.</p>
        </div>
      </div>
      <div class="split mt2">
        <img
          class="rimg short"
          src={`${base}assets/img/raw-materials-corn.jpg`}
          alt="Corn being unloaded for feed production"
          loading="lazy"
        />
        <div>
          <h3 class="h3l">Raw materials: local first</h3>
          <p class="muted">
            We prioritise local corn, cassava and rice by-products where available, in line with our
            agreement with the Ministry of Commerce.
          </p>
          <div class="mats">
            <div>
              <h3>Local</h3>
              <ul class="ticks">
                <li>Corn</li>
                <li>Cassava</li>
                <li>Broken rice</li>
                <li>Rice bran</li>
              </ul>
            </div>
            <div>
              <h3>Imported</h3>
              <ul class="ticks">
                <li>Soybean (100% USA)</li>
                <li>Soybean meal (USA/S. America)</li>
                <li>Meat and bone meal</li>
                <li>Blood meal</li>
                <li>Palm kernel meal</li>
                <li>DDGS (100% USA)</li>
                <li>Sunflower meal (100% USA)</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
